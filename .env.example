PORT=5001
MONGODB_URI=mongodb://localhost:27017/aurumx_trading_test
JWT_SECRET=change_me_local_only
JWT_EXPIRE=7d
NODE_ENV=development
APP_ENV=development

# Internal Node ↔ Python auth. Same value as the Python engine. Never expose to the browser.
ENGINE_SHARED_SECRET=
# Comma-separated extra browser origins (optional). Defaults include production frontend + localhost.
# CORS_ORIGINS=https://ai-tradingbot-frontend.vcl4xengine.com,http://localhost:3000

# Python AI engine (Node proxies /api/engine/* here)
# Local / test:
PYTHON_ENGINE_URL=http://localhost:8000
# Leave PYTHON_ENGINE_INTERNAL_URL unset locally (do not default to CapRover DNS).
# Production (CapRover app ai-tradingbot-python-engine):
# APP_ENV=production
# NODE_ENV=production
# MONGODB_URI=mongodb://.../aurumx_trading
# PYTHON_ENGINE_URL=https://ai-tradingbot-python-engine.vcl4xengine.com
# PYTHON_ENGINE_INTERNAL_URL=http://srv-captain--ai-tradingbot-python-engine:8000

# Default dashboard accounts (seed + upsert-users)
DEFAULT_ADMIN_EMAIL=admin@vcl4xengine.com
DEFAULT_ADMIN_PASSWORD=change_me
DEFAULT_USER_EMAIL=trader@vcl4xengine.com
DEFAULT_USER_PASSWORD=change_me
SEED_DEFAULT_PASSWORD=change_me

# Create/update admin + trader on server start (set true on CapRover backend once)
AUTO_UPSERT_DEFAULT_USERS=false

# Demo login when MongoDB is offline. Local only: set true. Production always rejects mock tokens.
ALLOW_MOCK_AUTH=false
MOCK_ADMIN_PASSWORD=change_me
MOCK_DEMO_PASSWORD=change_me

# Resend — signup OTP & password reset emails (5-digit code on register)
RESEND_API_KEY=
EMAIL_FROM=VCL4X <support@vcl4xengine.com>
DASHBOARD_URL=http://localhost:3000
PRODUCT_NAME=VCL4X

# NOWPayments — crypto checkout (live)
PAYMENT_PROVIDER=nowpayments
NOWPAYMENTS_MODE=live
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_PUBLIC_KEY=your_nowpayments_public_key
NOWPAYMENTS_IPN_SECRET=your_ipn_secret_from_nowpayments_dashboard
API_PUBLIC_URL=https://ai-tradingbot-backend.vcl4xengine.com

# PaymentCloud — legacy hosted checkout (optional fallback)
PAYMENTCLOUD_MODE=review
PAYMENTCLOUD_CHECKOUT_URL=
PAYMENTCLOUD_MERCHANT_ID=
PAYMENTCLOUD_API_KEY=
PAYMENTCLOUD_WEBHOOK_SECRET=
