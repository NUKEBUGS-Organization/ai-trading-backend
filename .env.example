PORT=5000
MONGODB_URI=mongodb://localhost:27017/aurumx_trading
JWT_SECRET=aurumx_super_secret_key_2024_change_in_production
JWT_EXPIRE=7d
NODE_ENV=development

# Python AI engine (Node proxies /api/engine/* here)
# Local:
PYTHON_ENGINE_URL=http://localhost:8000
# Production (CapRover app ai-tradingbot-python-engine):
# PYTHON_ENGINE_URL=https://ai-tradingbot-python-engine.vcl4xengine.com
# PYTHON_ENGINE_INTERNAL_URL=http://srv-captain--ai-tradingbot-python-engine:8000

# Default dashboard accounts (seed + upsert-users)
DEFAULT_ADMIN_EMAIL=admin@vcl4xengine.com
DEFAULT_ADMIN_PASSWORD=AdminX@2026!#
DEFAULT_USER_EMAIL=trader@vcl4xengine.com
DEFAULT_USER_PASSWORD=DemoX@2026!#

# Create/update admin + trader on server start (set true on CapRover backend once)
AUTO_UPSERT_DEFAULT_USERS=false

# Demo login when MongoDB is offline (never enable in production)
ALLOW_MOCK_AUTH=false
MOCK_ADMIN_PASSWORD=AdminX@2026!#
MOCK_DEMO_PASSWORD=DemoX@2026!#

# Resend — signup OTP & password reset emails (5-digit code on register)
# 1. Create API key at https://resend.com/api-keys
# 2. Verify your domain (e.g. vcl4xengine.com) in Resend dashboard
# 3. Set EMAIL_FROM to a verified address (NOT onboarding@resend.dev in production)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=VCL4X <support@vcl4xengine.com>
DASHBOARD_URL=https://ai-tradingbot-frontend.vcl4xengine.com
PRODUCT_NAME=VCL4X

# PaymentCloud — hosted checkout (merchant review / live)
PAYMENTCLOUD_MODE=review
PAYMENTCLOUD_CHECKOUT_URL=
PAYMENTCLOUD_MERCHANT_ID=
PAYMENTCLOUD_API_KEY=
PAYMENTCLOUD_WEBHOOK_SECRET=
API_PUBLIC_URL=https://your-backend.vcl4xengine.com
